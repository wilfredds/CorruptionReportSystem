# Copy to .env and fill in from your Supabase project
# (Supabase dashboard → Project Settings → Data API / API Keys)
#
# Both values are safe to expose in a browser bundle: the anon key only grants
# what Row-Level Security allows. See supabase/schema.sql for the policies.
#
# Leave these blank to run RallyReady fully offline — it falls back to a
# local-storage repository and everything in Phase 1 still works.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
