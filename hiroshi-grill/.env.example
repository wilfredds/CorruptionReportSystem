# Copy to .env.local (which is gitignored) and fill in. Never commit .env.local.
#
# The rule that matters: anything prefixed NEXT_PUBLIC_ is compiled into the
# JavaScript bundle and is readable by anyone who opens dev tools. Anything
# without that prefix stays on the server. Putting a secret behind a
# NEXT_PUBLIC_ name does not hide it — it publishes it.

# ---------------------------------------------------------------------------
# Milestone 1 (now)
# ---------------------------------------------------------------------------

# Canonical URL, used for metadata and the JSON-LD structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Milestone 2 onward (Supabase) — not read by any code yet
# ---------------------------------------------------------------------------

# Safe in the browser. The "anon" key grants no privileges of its own; every
# request it makes is still judged by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key BYPASSES Row Level Security entirely — it can read and
# delete every reservation in the database. It must never appear in a client
# component, never be prefixed NEXT_PUBLIC_, and on Vercel it belongs in the
# project's Environment Variables, not in any committed file.
SUPABASE_SERVICE_ROLE_KEY=
