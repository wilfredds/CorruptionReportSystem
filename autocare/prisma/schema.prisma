// AutoCare — Prisma schema
// Target: PostgreSQL (Neon free tier in production, Docker Postgres locally).
//
// Design note on future work (P2, intentionally NOT built in v1):
//   * Role already has room for a CUSTOMER value — adding it plus a nullable
//     User.customerId link is enough to open a customer portal later.
//   * JobPart carries a nullable catalog-style shape so inventory stock levels
//     can be layered on without touching historical rows.
//   * Nothing in the schema assumes a single branch; a Branch model can be added
//     with nullable branchId columns and backfilled.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  // CUSTOMER — reserved for the future customer portal (P2). Not issued in v1.
}

enum JobStatus {
  PAID
  UNPAID
  PARTIAL
}

enum PaymentMethod {
  CASH
  GCASH
  OTHER
}

model User {
  id                  String    @id @default(cuid())
  name                String
  username            String    @unique
  passwordHash        String
  role                Role      @default(STAFF)
  /// BCP-47-ish locale code, e.g. "fil", "en", "es". Stored as a string so a new
  /// language can be added by dropping one file into /messages — no migration.
  locale              String    @default("fil")
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Set the first time the user acknowledges the Acceptable Use Policy.
  policyAcceptedAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  createdCustomers Customer[] @relation("CustomerCreatedBy")
  createdJobs      Job[]      @relation("JobCreatedBy")
  mechanicJobs     Job[]      @relation("JobMechanic")
  auditLogs        AuditLog[]

  @@index([role])
  @@index([isActive])
}

model Customer {
  id          String   @id @default(cuid())
  fullName    String
  phone       String?
  address     String?
  notes       String?
  createdById String
  createdBy   User     @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles Vehicle[]
  jobs     Job[]

  @@index([fullName])
  @@index([phone])
  @@index([createdById])
}

model Vehicle {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plateNumber String
  make        String?
  model       String?
  year        Int?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs Job[]

  @@index([customerId])
  @@index([plateNumber])
}

/// Catalog of repeatable services. Editing an entry here never changes an
/// already-issued receipt: JobService stores its own name and price.
model Service {
  id           String   @id @default(cuid())
  name         String   @unique
  defaultPrice Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobServices JobService[]

  @@index([isActive])
}

model Job {
  id          String    @id @default(cuid())
  jobNumber   String    @unique
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id])
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id])
  mechanicId  String?
  mechanic    User?     @relation("JobMechanic", fields: [mechanicId], references: [id])
  date        DateTime  @default(now())
  status      JobStatus @default(UNPAID)

  laborCharge Decimal @default(0) @db.Decimal(12, 2)
  expenses    Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  amountPaid  Decimal @default(0) @db.Decimal(12, 2)
  balance     Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod?
  notes         String?

  createdById String
  createdBy   User     @relation("JobCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts    JobPart[]
  services JobService[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([date])
  @@index([status])
  @@index([createdById])
}

model JobPart {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  partName  String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  @@index([jobId])
  @@index([partName])
}

model JobService {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Denormalised on purpose — a historical receipt must never change when the
  /// Service catalog is edited or a catalog entry is deleted.
  serviceName String
  price       Decimal @db.Decimal(12, 2)

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([serviceId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// Single-row table holding the shop details printed on every receipt.
/// Editable from the Settings page by an ADMIN.
model ShopSetting {
  id        String   @id @default("shop")
  name      String
  address   String
  phone     String
  email     String?
  footer    String?
  updatedAt DateTime @updatedAt
}

/// Per-year counter backing the human-readable job number (JOB-2026-0001).
/// Incremented inside the same transaction that creates the Job.
model JobCounter {
  year       Int @id
  lastNumber Int @default(0)
}
