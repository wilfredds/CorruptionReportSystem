# ---------------------------------------------------------------- database
# Local Docker Postgres (see docker-compose.yml):
DATABASE_URL="postgresql://autocare:autocare@localhost:5432/autocare?schema=public"

# Neon (production). Copy the "Pooled connection" string from the Neon dashboard
# and keep ?sslmode=require at the end:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/autocare?sslmode=require"

# ------------------------------------------------------------------- auth
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# Your deployed URL. Vercel sets this automatically; needed for local HTTPS only.
# AUTH_URL="https://your-app.vercel.app"

# ---------------------------------------------------------------- optional
# Timezone used for dates on receipts and reports.
SHOP_TIMEZONE="Asia/Manila"

# Extra origins allowed to post Server Actions (only if behind a proxy/custom domain).
# ALLOWED_ORIGINS="your-app.vercel.app,shop.example.com"

# Override the seeded temporary admin passwords (optional).
# SEED_RAUL_PASSWORD="..."
# SEED_FRANCE_PASSWORD="..."
